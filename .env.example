# Supabase — create a free project at https://supabase.com, then copy from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build /r/<code> that is encoded in each QR/NFC
# Use your Vercel domain or custom domain, e.g. https://review.yourbrand.com
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
